# Database Configuration
MONGO_URI=mongodb://localhost:27017/dealbasket
# or for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dealbasket

# JWT Secrets (CRITICAL: Use different secrets for each in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here_64_chars_minimum
JWT_REFRESH_SECRET=your_refresh_token_secret_here_64_chars_minimum_different_from_access

# Token Expiration Times
JWT_ACCESS_EXPIRES_IN=15m   # Access tokens expire quickly (15 minutes)
JWT_REFRESH_EXPIRES_IN=30d  # Refresh tokens last longer (30 days)

# Application Configuration
NODE_ENV=development        # Set to 'production' for production environment
PORT=3000                  # Server port

# Frontend URL for CORS (adjust based on your frontend setup)
FRONTEND_URL=http://localhost:5173

# Security Notes:
# 1. NEVER commit actual secrets to version control
# 2. Use different secrets for development and production
# 3. Rotate secrets regularly in production
# 4. Store production secrets securely (Azure Key Vault, AWS Secrets Manager, etc.)
# 5. Access token should be short-lived (5-15 minutes)
# 6. Refresh token should be longer-lived (7-30 days)
# 7. Enable HTTPS in production (NODE_ENV=production)